{
  "name": "quiettip",
  "version": "0.2.0",
  "private": true,
  "description": "QuietTip high-fidelity prototype: optional, private tipping from a printed receipt QR code (fictional cafe, Stripe test mode).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "receipts:links": "node --env-file=.env.local scripts/receipt-links.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
