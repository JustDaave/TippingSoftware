# Copy to .env.local for local development, and add the same names in Vercel
# (Project -> Settings -> Environment Variables). Never commit real values.

# Public base URL used in printed QR codes and Stripe return links.
# Local: http://localhost:3000   Deployed: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> Data API for the URL, Project Settings -> API Keys for keys).
# Server-only: no NEXT_PUBLIC_ prefix, so these never reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Optional. NOT used by the app. Only `npm run verify:supabase` uses it, to prove the public
# key can read and change nothing. Do not add it to Vercel.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Stripe TEST mode only (Dashboard -> Developers -> API keys, with "Test mode" on).
# The app refuses keys that do not start with sk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen` locally, or from the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: random string used to hash IP addresses for rate limiting.
RATE_LIMIT_SALT=replace_with_a_long_random_string
